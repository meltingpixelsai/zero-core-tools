# Grok API (xAI)
XAI_API_KEY=

# x402 Payment
PAYMENT_WALLET=2MB8Gk4PebwhP6yaiiMjofHYoQvvQ8iWo3hdkUHQ1Wdq
X402_FACILITATOR=https://facilitator.payai.network

# Server
PORT=8403
NODE_ENV=production

# Browser (src/lib/browser.ts). The browser's process sandbox is ON by default, and the server runs the host's
# Google Chrome (install google-chrome-stable, keep it current, restart the server after a Chrome upgrade).
# Leave BROWSER_CHANNEL unset for that; only the exact value "chromium" selects the build Playwright bundles,
# for a host without Google Chrome. On a host that restricts unprivileged user namespaces (Ubuntu 24.04) the
# bundled build also needs a root-owned setuid sandbox helper named in CHROME_DEVEL_SANDBOX; the production
# process manager config (ecosystem.config.cjs) sets it. Only BROWSER_SANDBOX=off turns the sandbox off
# (the Dockerfile does, for a root-in-container run); never set it in production.
# BROWSER_CHANNEL=
# CHROME_DEVEL_SANDBOX=/opt/google/chrome/chrome-sandbox
# BROWSER_SANDBOX=
